# Sidecar Zalo cá nhân — copy thành .env (không commit .env).
# Node tự đọc file .env cạnh package.json khi chạy `npm run dev` / `npm start`.

# Cổng HTTP nội bộ cho API .NET gọi vào (CONTRACT §1). Chỉ nghe 127.0.0.1, trừ khi đặt REMI_HOST.
REMI_PORT=4100
# REMI_HOST=0.0.0.0          # chỉ dùng trong Docker (mạng nội bộ), không mở ra Internet

# Cổng nội bộ của API .NET (/internal/zalo-personal/*)
REMI_API_URL=http://127.0.0.1:4001

# BẮT BUỘC, >= 32 ký tự, giống hệt ZaloPersonal:SharedSecret bên .NET. Thiếu/ngắn → sidecar không chạy.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REMI_SHARED_SECRET=

# real = zca-js thật | fake = giả lập (chỉ dev, có POST /dev/simulate)
REMI_MODE=fake

# Tên bản sidecar gửi trong /sync (mặc định: <hostname>-<pid>)
# REMI_INSTANCE_ID=

# Nhịp /sync (đối soát + gia hạn lease), mili giây
REMI_SYNC_INTERVAL_MS=60000

# debug | info | warn | error
REMI_LOG_LEVEL=info
