# Sao chép thành .env (không commit). Quy ước .NET: "__" = phân cấp section, ví dụ Ai__ChatModel <-> Ai:ChatModel.
# Dev: secret nên đặt bằng `dotnet user-secrets` thay vì file này.

ASPNETCORE_ENVIRONMENT=Development
App__AdminUrl=http://localhost:3000
App__ApiUrl=http://localhost:4000
App__PublicWebhookBaseUrl=

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=zaloai;Username=app;Password=app
ConnectionStrings__Redis=localhost:6379

# 32 bytes base64 cho AES-256-GCM. Tạo bằng PowerShell:
# $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
Security__EncryptionKey=

# Chat: Gemini, hết lượt/lỗi thì sang Groq (fake = giả lập cho test). Embedding: chỉ Gemini.
# Production: key Gemini gói TRẢ PHÍ (gói miễn phí cho Google dùng dữ liệu). Groq: bật Zero Data Retention ở console.groq.com → Data Controls.
Ai__ChatProvider=gemini
Ai__ChatModel=gemini-3.5-flash-lite
Ai__ChatFallbackModel=gemini-3.8-flash
Ai__EmbedProvider=gemini
Ai__EmbedModel=
Ai__EmbedDim=768
Ai__GeminiApiKey=

# Thứ tự thử khi lỗi tạm thời / hết lượt / JSON hỏng: gemini (ChatModel → ChatFallbackModel) rồi groq (GroqModels theo thứ tự).
# Đặt "groq" để chạy eval riêng với Groq. Sai key (401) hay request sai (400) thì KHÔNG chuyển, log Error.
Ai__ChatProviders=gemini,groq
# Trống = không dùng Groq.
Ai__GroqApiKey=
Ai__GroqModels=openai/gpt-oss-120b,openai/gpt-oss-20b
# json_schema (strict, model gpt-oss) | json_object (mọi model, schema gửi trong prompt) — đổi khi Groq từ chối schema (400).
Ai__GroqJsonMode=json_schema
# low | medium | high cho gpt-oss; để trống với model không có chế độ suy nghĩ.
Ai__GroqReasoningEffort=low
# Trần token trả lời gửi Groq (gồm token suy nghĩ): prompt + trần phải nằm trong số token/phút của gói.
Ai__GroqMaxCompletionTokens=2048
# 429 kèm retry-after ≤ N giây → chờ rồi thử lại cùng model; model hết lượt bị bỏ qua N giây.
Ai__ChatMaxRetryAfterSeconds=10
Ai__ChatCooldownSeconds=60

Zalo__AppId=
Zalo__AppSecret=
Zalo__OAuthRedirectUrl=                      # https://dev-api.haulp.io.vn/connect/zalo/callback (khai báo y hệt trên trang app Zalo)
Zalo__WebhookSecret=                         # "OA Secret Key" trên trang Webhook của app (KHÁC AppSecret)

Sentry__Dsn=
Telegram__BotToken=
